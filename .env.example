# PostgreSQL connection string (e.g., Render, Supabase, Neon, or local PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database_name?ssl=true

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Backend base URL
API_URL=http://localhost:4000

# Optional server port (defaults to 4000)
PORT=4000
